{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "iw-mega-menu/mega-menu",
	"title": "IW Mega Menu",
	"category": "theme",
	"icon": "menu-alt3",
	"description": "Display a mega menu built with the IW Mega Menu builder.",
	"keywords": [ "menu", "navigation", "mega menu" ],
	"textdomain": "iw-mega-menu",
	"attributes": {
		"menuId": {
			"type": "number",
			"default": 0
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "iw-mega-menu-block-editor",
	"style": "iw-mega-menu"
}
